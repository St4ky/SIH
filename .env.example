# Gap2Grow - Environment Configuration Template

# Database Connection
DB_HOST=localhost
DB_NAME=gap2grow
DB_USER=root
DB_PASS=

# Base URL (Do not include trailing slash)
BASE_URL=http://localhost/SIH

# Google Gemini API Key (For AI Assessment Generator and Copilot)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Resource Cache Lifetime (hours)
RESOURCE_CACHE_HOURS=6
